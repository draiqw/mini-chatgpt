# Скопировать в .env и поменять. .env в git не кладём.
POSTGRES_PASSWORD=change-me
# порт nginx на хосте; локально удобнее 8090
PORT=80
LLM_MODEL=Qwen3-1.7B-Q8_0.gguf
# потоков CPU для модели
LLM_THREADS=6
# Только на сервере с доменом (HTTPS). Сертификат: scripts/issue-cert, он же допишет COMPOSE_FILE.
# DOMAIN=chat.myocto.ru
