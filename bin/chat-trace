#!/bin/sh
# Путь одного запроса через все сервисы по времени: chat-trace <X-Request-ID>
# rid показан в чате под каждым ответом. Строки вида: [откуда → куда] что произошло.
[ -n "$1" ] || { echo "usage: chat-trace <request-id>" >&2; exit 1; }
docker compose -f "${CHAT_DIR:-/opt/mini-chatgpt}/compose.yaml" logs --no-color --timestamps nginx api worker db 2>/dev/null \
  | grep -F "$1" | sort -k3 | sed -E 's/^([a-z]+)-1 +\| ([0-9T:-]+)\.([0-9]{3})[0-9]*Z /\2.\3 \1  /'
